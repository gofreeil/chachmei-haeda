# ================================================================
# קובץ זה הוא תבנית — צור .env ומלא את הערכים האמיתיים
# ================================================================

# Resend API Key — נדרש לשליחת מיילי אישור הזמנה
# הירשם בחינם על https://resend.com  →  API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# כתובת שממנה יישלחו המיילים
# ב-Resend חינמי ניתן להשתמש ב: onboarding@resend.dev (לטסטים)
# לייצור: אמת את הדומיין שלך ב-Resend ואז השתמש ב-ads@shchuna.co.il
FROM_EMAIL=onboarding@resend.dev

# ================================================================
# Auth.js — Google + Facebook OAuth
# ================================================================

# AUTH_SECRET — מחרוזת אקראית לחתימת JWT (חובה!)
# ייצר עם: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com
# APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Authorized redirect URIs: http://localhost:5173/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook OAuth — https://developers.facebook.com
# My Apps → Add Product → Facebook Login
# Valid OAuth Redirect URIs: http://localhost:5173/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# ================================================================
# Web Push VAPID Keys
# ייצר עם: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k)"
# ================================================================
PUBLIC_VAPID_PUBLIC_KEY=BG4X8adsiqo7IeEfNNMQus75sYxzmG2vD94IrIOmFMm5bK9JSp3v-AB6ZRvVYcLSL_0o_N3z3P_t_x9hHGYIwKA
VAPID_PRIVATE_KEY=6CK8CaJOO35lyeLS9JIYRheL1MW_Vv6VSOVV4rgtZPM
VAPID_EMAIL=mailto:admin@kahal.co.il

# טוקן מצומצם ב-Strapi — הרשאות push-subscription בלבד (לא Full Access!)
# Strapi → Settings → API Tokens → Create → Custom → push-subscription: create, find, delete
STRAPI_PUSH_TOKEN=

# ================================================================
# איתניום (eitanium.org) — חדרי מפגש וירטואליים לדיונים ולפיוס
# חשבון-שירות באיתניום עם ההרשאה "Can create meetings" (בלי אימות דו-שלבי).
# בית הדין פותח חדר מדף התיק; בלי שני אלה הכפתור מוצג כ"לא הוגדר".
# ================================================================
EITANIUM_USER=
EITANIUM_PASS=
# EITANIUM_URL=https://eitanium.org

# ================================================================
# ניתוח PDF אוטומטי (admin) — מילוי כותרת/מחבר/תאריך/תקציר/תגיות/דיינים
# https://console.anthropic.com → API Keys. בלי המפתח: נשאר המילוי הבסיסי (כותרת=שורה ראשונה).
# ================================================================
ANTHROPIC_API_KEY=
# אופציונלי — ברירת מחדל claude-opus-5-5
ANTHROPIC_MODEL=
